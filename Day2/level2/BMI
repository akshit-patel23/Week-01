//to find the BMI of a person

import java.util.Scanner;

public class BMI {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

         System.out.print("Enter your weight (in kg): ");
        double weight = sc.nextDouble();

          System.out.print("Enter your height (in cm): ");
        double heightInCm = sc.nextDouble();

        
        double heightInMeters = heightInCm / 100.0; //1 meter =100cm
        
        double bmi = weight / (heightInMeters * heightInMeters); // formula BMI = weight / (height^2)

        System.out.println("\nYour BMI is: " + bmi);

        
        String weightStatus;
	
        if (bmi < 18.4) {
            weightStatus = "Underweight";
        } else if (bmi >= 18.5 && bmi < 24.9) {
            weightStatus = "Normal weight";
        } else if (bmi >= 25 && bmi < 39.9) {
            weightStatus = "Overweight";
        } else {
            weightStatus = "Obesity";
        }

        
        System.out.println("The weight status of the person: " + weightStatus);

            }
}









